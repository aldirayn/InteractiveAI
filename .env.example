# Salin menjadi ".env" di server (file .env TIDAK di-commit), lalu isi.

# Folder model AI di server (pakai garis miring "/" di Windows)
MODEL_DIR=D:/InteractiveAI_Dev/backend/model
MODELS_DIR=D:/InteractiveAI_Dev/backend/Models
LOG_DIR=D:/InteractiveAI_Dev/docker-logs

# Port di server
BACKEND_PORT=5000
FRONTEND_PORT=5001

# API key (kosong = pakai nilai di appsettings.json)
OLLAMA_API_KEY=
ELEVENLABS_API_KEY=

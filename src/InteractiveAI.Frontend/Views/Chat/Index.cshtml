@{
    ViewData["Title"] = "Mira - Loket WO";
    ViewData["LoketWide"] = true;
}

<div id="startScreen" class="flex-col items-center justify-center min-h-[70vh] text-center px-6" style="display:flex">
    <p class="text-slate-400 text-sm">Selamat datang di</p>
    <h1 class="font-bold text-3xl leading-tight bg-gradient-to-r from-white via-purple-200 to-cyan-200 bg-clip-text text-transparent mt-1">Mira<br />Loket WO</h1>
    <p class="text-slate-400 text-sm mt-2">Klik Mulai, hadap ke kamera,<br />AI menyapa otomatis.</p>
    <button id="btnStart" class="mt-6 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white px-8 py-3 rounded-2xl font-medium shadow-lg shadow-purple-900/30" type="button"><i class="fas fa-microphone"></i> Mulai percakapan</button>
</div>

<div id="chatView" class="flex-1 flex-col min-h-0" style="display:none">
    <div aria-hidden="true" style="display:none !important">
        <select id="modelSelect"><option>memuat...</option></select>
        <button id="btnReloadModels" type="button"></button>
        <select id="voiceSelect">
            <option value="id-ID-GadisNeural">Gadis (wanita)</option>
            <option value="id-ID-ArdiNeural">Ardi (pria)</option>
            <option value="browser" selected>Browser (robot)</option>
        </select>
        <select id="rateSelect">
            <option value="-10">Lambat (-10)</option>
            <option value="0" selected>Santai (0)</option>
            <option value="12">Cerah (+12)</option>
            <option value="25">Cepat (+25)</option>
        </select>
        <button id="btnVoiceMode" type="button"></button>
        <button id="btnMakeWo" type="button"></button>
        <div id="statusBar">Siap.</div>
        <div id="statusPill" class="ai-statuspill">Siap.</div>
    </div>

    <div id="permBanner" class="ai-banner" style="display:none">
        <b>Kamera belum aktif.</b> <span id="permText">Browser butuh sekali klik untuk memberi izin kamera + suara.</span>
        <button id="btnEnableAll" class="ai-btn-primary ai-btn-sm" type="button"><i class="fas fa-video"></i> Aktifkan Kamera &amp; Suara</button>
    </div>

    <div class="loket-nopol shrink-0">
        <span class="loket-nopol-label">Nopol</span>
        <div id="plateHead" class="loket-nopol-value">—</div>
    </div>

    <div class="loket-gridwrap flex-1 min-h-0 loket-scroll">
        <div class="loket-grid">
            <section class="loket-form glass-panel" aria-label="Form keluhan">
                <div class="loket-frow">
                    <label>Nama Sopir</label>
                    <input type="text" id="fNama" class="fInfo" placeholder="Nama sopir..." readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Jenis Truk</label>
                    <input type="text" id="fJenis" class="fInfo" placeholder="Jenis truk..." readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Truk</label>
                    <input type="text" class="fKeluhan" data-cat="Truk" placeholder="Keluhan truk... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Truk" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Reefer</label>
                    <input type="text" class="fKeluhan" data-cat="Reefer" placeholder="Keluhan reefer/AC... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Reefer" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Cabin</label>
                    <input type="text" class="fKeluhan" data-cat="Cabin" placeholder="Keluhan cabin (non-AC)... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Cabin" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>GPS</label>
                    <input type="text" class="fKeluhan" data-cat="GPS" placeholder="Keluhan GPS... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_GPS" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Genset</label>
                    <input type="text" class="fKeluhan" data-cat="Genset" placeholder="Keluhan genset... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Genset" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Box</label>
                    <input type="text" class="fKeluhan" data-cat="Box" placeholder="Keluhan box... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Box" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
                <div class="loket-frow">
                    <label>Ban</label>
                    <input type="text" class="fKeluhan" data-cat="Ban" placeholder="Keluhan ban... (Enter untuk kirim)" autocomplete="off" />
                    <input type="text" id="fWo_Ban" class="fWo" placeholder="WO-XXXX" readonly autocomplete="off" />
                </div>
            </section>

            <aside class="loket-side">
                <div class="loket-persona glass-panel">
                    <div class="loket-ava">
                        <div id="voiceOrb" title="Ketuk untuk menyalakan/mematikan mic" style="cursor:pointer" aria-hidden="true">
                            <svg id="cs-avatar-svg" viewBox="0 0 400 400" class="w-full h-full object-cover">
                                <defs>
                                    <linearGradient id="skin-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#ffdfd3" />
                                        <stop offset="60%" stop-color="#f5c2b3" />
                                        <stop offset="100%" stop-color="#e0a394" />
                                    </linearGradient>
                                    <linearGradient id="hair-grad" x1="0%" y1="0%" x2="0%" y2="100%">
                                        <stop offset="0%" stop-color="#2d1b2d" />
                                        <stop offset="50%" stop-color="#1a101f" />
                                        <stop offset="100%" stop-color="#0d0810" />
                                    </linearGradient>
                                    <linearGradient id="suit-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" stop-color="#1e1b4b" />
                                        <stop offset="100%" stop-color="#0f172a" />
                                    </linearGradient>
                                    <radialGradient id="eye-iris" cx="50%" cy="50%" r="50%">
                                        <stop offset="0%" stop-color="#38bdf8" />
                                        <stop offset="70%" stop-color="#0284c7" />
                                        <stop offset="100%" stop-color="#0c4a6e" />
                                    </radialGradient>
                                    <linearGradient id="lip-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                                        <stop offset="0%" stop-color="#e11d48" />
                                        <stop offset="50%" stop-color="#f43f5e" />
                                        <stop offset="100%" stop-color="#e11d48" />
                                    </linearGradient>
                                </defs>
                                <circle cx="200" cy="200" r="195" fill="#0f172a" />
                                <path d="M 100,180 Q 80,320 120,400 L 280,400 Q 320,320 300,180 Z" fill="url(#hair-grad)" />
                                <path d="M 120,320 Q 200,300 280,320 L 320,400 L 80,400 Z" fill="url(#suit-grad)" />
                                <polygon points="175,320 200,360 225,320 200,380" fill="#ffffff" opacity="0.9" />
                                <path d="M 120,320 L 175,370 L 155,400 L 80,400 Z" fill="#312e81" />
                                <path d="M 280,320 L 225,370 L 245,400 L 320,400 Z" fill="#312e81" />
                                <path d="M 170,250 L 230,250 L 235,325 Q 200,335 165,325 Z" fill="#e0a394" />
                                <path d="M 130,170 Q 130,270 200,275 Q 270,270 270,170 Q 270,100 200,100 Q 130,100 130,170 Z" fill="url(#skin-grad)" />
                                <ellipse cx="155" cy="215" rx="18" ry="10" fill="#f43f5e" opacity="0.15" />
                                <ellipse cx="245" cy="215" rx="18" ry="10" fill="#f43f5e" opacity="0.15" />
                                <g id="left-eye">
                                    <ellipse cx="165" cy="180" rx="16" ry="10" fill="#ffffff" />
                                    <circle cx="165" cy="180" r="7" fill="url(#eye-iris)" />
                                    <circle cx="165" cy="180" r="3.5" fill="#090d16" />
                                    <circle cx="162" cy="177" r="2" fill="#ffffff" />
                                    <path d="M 147,180 Q 165,166 183,180" stroke="#1e1022" stroke-width="2.5" fill="none" stroke-linecap="round" />
                                </g>
                                <g id="right-eye">
                                    <ellipse cx="235" cy="180" rx="16" ry="10" fill="#ffffff" />
                                    <circle cx="235" cy="180" r="7" fill="url(#eye-iris)" />
                                <circle cx="235" cy="180" r="3.5" fill="#090d16" />
                                <circle cx="232" cy="177" r="2" fill="#ffffff" />
                                    <path d="M 217,180 Q 235,166 253,180" stroke="#1e1022" stroke-width="2.5" fill="none" stroke-linecap="round" />
                                </g>
                                <path d="M 148,162 Q 165,155 180,162" stroke="#2d1b2d" stroke-width="2.5" fill="none" stroke-linecap="round" />
                                <path d="M 220,162 Q 235,155 252,162" stroke="#2d1b2d" stroke-width="2.5" fill="none" stroke-linecap="round" />
                                <path d="M 200,180 L 197,212 Q 200,216 203,212 Z" fill="#d49282" opacity="0.6" />
                                <g id="mouth-group">
                                    <path id="mouth-path" d="M 175,238 Q 200,252 225,238 Q 200,244 175,238 Z" fill="url(#lip-grad)" />
                                    <path id="mouth-opening" d="M 180,240 Q 200,242 220,240 Q 200,241 180,240 Z" fill="#580812" opacity="0" />
                                </g>
                                <path d="M 130,150 Q 170,110 200,140 Q 240,110 270,150 Q 280,100 200,80 Q 120,100 130,150 Z" fill="url(#hair-grad)" />
                                <path d="M 125,170 Q 120,80 200,80 Q 280,80 275,170" stroke="#64748b" stroke-width="4" fill="none" />
                                <rect x="118" y="160" width="10" height="28" rx="4" fill="#38bdf8" />
                                <rect x="272" y="160" width="10" height="28" rx="4" fill="#38bdf8" />
                                <path d="M 277,180 Q 260,240 215,235" stroke="#475569" stroke-width="3" fill="none" stroke-linecap="round" />
                                <circle cx="213" cy="235" r="5" fill="#a855f7" />
                            </svg>
                            <canvas id="orbWave"></canvas>
                        </div>
                    </div>
                    <div class="loket-ava-id">
                        <div class="loket-ava-name">Mira</div>
                        <div class="loket-ava-sub">
                            <span id="status-indicator-dot" class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
                            <span id="status-text">Siap Membantu</span>
                        </div>
                    </div>
                    <div id="speaking-wave" class="items-end space-x-1 h-6 px-3 py-1 rounded-full bg-cyan-950/40 border border-cyan-500/20 hidden" style="display:none">
                        <div class="sound-bar"></div>
                        <div class="sound-bar"></div>
                        <div class="sound-bar"></div>
                        <div class="sound-bar"></div>
                        <div class="sound-bar"></div>
                    </div>
                    <div class="ai-listening"><span class="ai-pulse"></span><span id="listenLabel">Siaga</span></div>
                </div>

                <div class="loket-cam glass-panel">
                    <span class="loket-live"></span>
                    <video id="camMini" playsinline muted></video>
                    <div class="loket-cam-meta">
                        <span id="camDot" class="ai-badge">kamera...</span>
                        <button id="btnCamRetry" type="button" title="Coba nyalakan kamera lagi" class="text-slate-400 hover:text-white text-xs px-1"><i class="fas fa-redo"></i></button>
                    </div>
                    <div id="detectInfo" class="ai-detect">Mendeteksi manusia...</div>
                </div>

                <div class="loket-qr glass-panel">
                    <span class="loket-qr-label">QR Kimo</span>
                    <span id="qrBadge" class="loket-qr-value">belum discan</span>
                </div>
            </aside>
        </div>
    </div>

    <section id="chatPanel" class="loket-chat glass-panel shrink-0" aria-label="Percakapan">
            <div class="loket-chat-head">
                <div class="flex items-center space-x-3 min-w-0">
                    <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-purple-600 to-cyan-400 p-0.5 flex items-center justify-center shrink-0">
                        <div class="w-full h-full bg-slate-950 rounded-full flex items-center justify-center">
                            <i class="fas fa-truck font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-cyan-400"></i>
                        </div>
                    </div>
                    <div class="min-w-0">
                        <div class="loket-chat-title flex items-center gap-2">Riwayat Percakapan <span id="chatNewBadge" class="loket-chat-badge" style="display:none">0</span></div>
                        <div id="chatPreview" class="loket-chat-preview"></div>
                    </div>
                </div>
                <div class="flex items-center space-x-2 shrink-0">
                    <button id="btnTheme" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white" type="button" title="Ganti tema terang/gelap"><i id="iconTheme" class="fas fa-sun"></i></button>
                    <button id="btnChatToggle" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white" type="button" title="Sembunyikan riwayat (fokus ke nopol &amp; keluhan)"><i id="iconChatToggle" class="fas fa-chevron-down"></i></button>
                    <button id="btnSpeaker" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white active" type="button" title="Bacakan jawaban AI"><i id="icon-speaker" class="fa-solid fa-volume-high text-cyan-400"></i></button>
                    <button id="btnVoiceRefresh" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white" type="button" title="Percakapan baru"><i class="fas fa-rotate"></i></button>
                    <button id="btnDrawer" class="glass-button w-9 h-9 rounded-xl flex items-center justify-center text-slate-300 hover:text-white" type="button" title="Riwayat sesi"><i class="fas fa-clock-rotate-left"></i></button>
                </div>
            </div>
            <div id="toast" class="ai-toast" style="display:none"></div>
            <div id="chatBox" class="loket-chatbox loket-scroll"></div>
            <div class="loket-chat-quick px-4 py-2 border-t border-slate-800/80 bg-slate-900/30 flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0">
                <span class="text-xs text-slate-400 whitespace-nowrap"><i class="fa-solid fa-bolt text-amber-400"></i> Cepat:</span>
                <button class="ai-qpill glass-button px-3 py-1 rounded-full text-xs text-slate-300 hover:text-purple-300 whitespace-nowrap" type="button" data-prompt="Halo, saya mau buat work order service truk."><i class="fas fa-wand-magic-sparkles"></i><span>Buat WO service truk…</span></button>
                <button class="ai-qpill glass-button px-3 py-1 rounded-full text-xs text-slate-300 hover:text-purple-300 whitespace-nowrap" type="button" data-prompt="Saya mau cek status work order saya."><i class="fas fa-wand-magic-sparkles"></i><span>Cek status WO…</span></button>
            </div>
            <div class="p-3 sm:p-4 border-t border-slate-800 bg-slate-950/80 shrink-0">
                <form id="chat-form" class="flex items-center gap-2">
                    <button type="button" id="btnMic" class="glass-button p-3 rounded-xl text-slate-300 hover:text-purple-400 flex items-center justify-center transition-all" title="Tahan untuk bicara, klik untuk always-on"><i class="fa-solid fa-microphone text-lg"></i></button>
                    <button type="button" id="btnKeyboard" class="glass-button p-3 rounded-xl text-slate-300 hover:text-purple-400 flex items-center justify-center transition-all" title="Keyboard layar"><i class="fas fa-keyboard"></i></button>
                    <div class="relative flex-1">
                        <input type="text" id="inputMsg" placeholder="Ketik atau bicara saja..." autocomplete="off" class="w-full bg-slate-900/90 border border-slate-700/80 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-500 focus:outline-none focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition-all" />
                    </div>
                    <button type="submit" id="btnSend" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white p-3 rounded-xl font-medium transition-all shadow-lg shadow-purple-900/30 flex items-center justify-center" title="Kirim"><i class="fa-solid fa-paper-plane text-base"></i></button>
                </form>
                <div class="flex items-center justify-between text-[11px] text-slate-500 mt-2 px-1">
                </div>
            </div>
    </section>

    <div id="vkb" style="display:none">
        <div id="vkbHead" class="flex items-center justify-between mb-2">
            <span class="text-xs text-slate-400"><i class="fas fa-keyboard"></i> Ketik manual <span class="text-slate-600">— tarik area ini untuk geser</span></span>
            <button type="button" id="vkbClose" class="text-slate-400 hover:text-white text-sm px-2" title="Tutup keyboard"><i class="fas fa-times"></i></button>
        </div>
        <div id="vkbKeys" class="grid grid-cols-10 gap-1.5 pb-1"></div>
    </div>

    <div id="woDone" class="ai-modal" style="display:none">
        <div class="ai-modal-box glass-panel">
            <div id="woDoneSave">
                <b>Menyimpan Work Order</b>
                <p id="woSaveStep" class="ai-modal-note">Menghubungi sistem...</p>
                <div class="wo-progress"><div id="woProgressBar"></div></div>
                <p id="woSaveElapsed" class="ai-modal-note">0 dtk</p>
            </div>
            <div id="woDoneView" style="display:none">
                <b>WO berhasil dibuat</b>
                <p id="woDoneNote" class="ai-modal-note">Nomor WO sudah tersimpan di sistem.</p>
                <div id="woDoneList" class="wo-wolist"></div>
                <p id="woDoneCountdown" class="ai-modal-note"></p>
                <div class="ai-modal-actions">
                    <button id="btnWoDoneNext" class="ai-btn-glow ai-btn-sm" type="button">Selesai</button>
                </div>
            </div>
        </div>
    </div>

    <aside id="aiDrawer" class="ai-drawer" aria-hidden="true">
        <div class="ai-drawer-head">
            <span><i class="fas fa-comments"></i> Sesi Percakapan</span>
            <button id="btnDrawerClose" class="ai-iconbtn" type="button"><i class="fas fa-times"></i></button>
        </div>
        <div class="ai-drawer-new">
            <button id="btnNew" class="ai-btn-primary" type="button"><i class="fas fa-plus"></i><span class="txt"> Chat baru</span></button>
        </div>
        <ul id="sessionList" class="ai-sessions"></ul>
        <a asp-controller="Vision" asp-action="Index" class="ai-drawer-link"><i class="fas fa-eye"></i> Face Detection</a>
    </aside>
    <div id="drawerScrim" class="ai-scrim"></div>
</div>

@section Scripts {
<script src="~/lib/tailwind/tailwindcss.js" asp-append-version="true"></script>
<script type="importmap">{"imports":{"@@mediapipe/tasks-vision":"/lib/mediapipe/vision_bundle.js"}}</script>
<script type="module" src="~/js/vision-speech.js" asp-append-version="true"></script>
<script src="~/js/chat.js" asp-append-version="true"></script>
<script src="~/js/voice-ui.js" asp-append-version="true"></script>
}
